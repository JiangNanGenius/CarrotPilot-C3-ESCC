#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/device.py
msgid "Controls the state of the device after boot/sleep. Use Offroad only for parked updates or harness debugging."
msgstr "控制裝置啟動/喚醒後的狀態。Offroad 只用於停車更新或線束調試。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/device.py
msgid "Offroad: Device will boot into parked maintenance mode and keep panda in no-output mode."
msgstr "Offroad：裝置會進入停車維護模式，並讓 panda 保持無輸出模式。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/device.py
msgid "Exit Always Offroad mode and allow normal startup on the next drive?"
msgstr "退出 Always Offroad，並允許下次駕駛正常啟動？"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/device.py
msgid "Enter Always Offroad mode for parked maintenance? The device will stay offroad and panda will remain no-output until you turn this off."
msgstr "進入停車維護用 Always Offroad 模式？關閉前裝置會保持 offroad，panda 會保持無輸出。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/models.py
msgid "Stock is the default. Select or download custom model bundles only while offroad; failed bundles fall back to stock or the last valid model."
msgstr "預設使用原廠模型。只能在 offroad 狀態選擇或下載自訂模型包；失敗時會回退到原廠模型或上一個有效模型。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/models.py
msgid "Fetches the remote model list for manual offroad updates. This is not a cloud pairing service."
msgstr "拉取遠端模型列表，用於手動 offroad 更新；這不是雲端配對服務。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/models.py
msgid "Deletes downloaded model cache files except the active model. Use only while parked if storage needs to be reclaimed."
msgstr "刪除已下載的模型快取，但保留目前啟用模型。只在停車且需要清理空間時使用。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/models.py
msgid "Only available while offroad. Do not change model bundles during a drive."
msgstr "僅 offroad 時可用。行駛中不要切換模型包。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/models.py
msgid "Stock is the default. Download, validate, and switch custom model bundles only while parked."
msgstr "預設使用原廠模型。下載、校驗和切換自訂模型包只能在停車時進行。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Off: Disables speed limit display, warnings, and assist."
msgstr "關閉：停用限速顯示、警告和輔助。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Information: Displays the resolved speed limit only. This is the default and does not change cruise targets."
msgstr "資訊：只顯示解析出的限速。這是預設值，不會改變巡航目標。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Warning: Displays the limit and warns when current speed exceeds it."
msgstr "警告：顯示限速，並在目前速度超過限速時提醒。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Assist: May adjust cruise targets on supported cars. Use only after phone and vehicle sources have been verified; test map policies separately."
msgstr "輔助：在支援的車輛上可能調整巡航目標。只有在手機和車輛限速來源驗證後再使用；地圖策略請單獨測試。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "None: No offset. This is the default and safest setting."
msgstr "無：不加偏移。這是預設且最安全的設定。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Fixed: Adds a fixed km/h or mph offset to the detected limit."
msgstr "固定：在偵測到的限速上增加固定 km/h 或 mph 偏移。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_settings.py
msgid "Percent: Adds a percentage of the detected limit. Keep at 0 until the source is reliable."
msgstr "百分比：按偵測限速增加一定比例。限速來源可靠前保持 0。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Car Only: Use speed limit data only from the vehicle or cluster when available."
msgstr "僅車機：只使用車輛或儀表提供的限速資料。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Map Only: Use speed limit data only from OpenStreetMap/mapd."
msgstr "僅地圖：只使用 OpenStreetMap/mapd 限速資料。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Car First: Use vehicle speed limit first; fall back to OpenStreetMap/mapd."
msgstr "車機優先：優先使用車輛限速，再回退到 OpenStreetMap/mapd。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Map First: Use OpenStreetMap/mapd first; fall back to vehicle speed limit."
msgstr "地圖優先：優先使用 OpenStreetMap/mapd，再回退到車輛限速。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Combined: Use combined vehicle and OpenStreetMap/mapd data."
msgstr "組合：結合車輛和 OpenStreetMap/mapd 限速資料。"

#: openpilot/selfdrive/ui/sunnypilot/layouts/settings/cruise_sub_layouts/speed_limit_policy.py
msgid "Phone First: Use fresh APN/N, Navipilot, or Carrot phone data first. Stale phone data times out, then falls back to vehicle/cluster data. OpenStreetMap/mapd is opt-in through the map policies."
msgstr "手機優先：優先使用新鮮的 APN/N、Navipilot 或 Carrot 手機限速資料。過期手機資料會超時，然後回退到車輛/儀表限速。OpenStreetMap/mapd 只在地圖策略中手動啟用。"

msgid "Super Advanced"
msgstr "Super Advanced"

msgid "This personal build keeps cruise-speed behavior aligned with CarrotPilot. SunnyPilot ICBM, SCC-V, and SCC-M stay hidden and forced off. Sunny DEC is available as an off-by-default advanced option in Cruise and Super Advanced settings."
msgstr "這個個人版的巡航控速邏輯以 CarrotPilot 為準。SunnyPilot 的 ICBM、SCC-V 和 SCC-M 會隱藏並強制關閉。Sunny DEC 作為預設關閉的進階候選功能放在 Cruise 和 Super Advanced 設定裡。"

msgid "Genius Lane Change Visuals"
msgstr "Genius 變道視覺化"

msgid "Show lane-change intent cues on the driving screen using the model lane-change events. This is display-only."
msgstr "使用模型變道事件，在駕駛畫面顯示變道意圖提示。此功能只影響顯示。"

msgid "Fishop Visual Overlay"
msgstr "Fishop 視覺化疊加"

msgid "Draw Fishop lane, lidar lane, blindspot, and overtake suggestion evidence on top of any visual preset only while the local hardware data is fresh. This does not enable automatic overtake control."
msgstr "在任意顯示預設上疊加 Fishop 車道、雷射雷達車道、盲區和超車建議證據；只有本地硬體資料新鮮時才會顯示。它不會啟用自動超車控制。"

msgid "Carrot World Overlay"
msgstr "Carrot 世界疊加層"

msgid "Draw Carrot-style side-lane, blindspot, lane-change, lead, and radar evidence on top of the selected visual preset. This is display-only and does not change lane-change or control decisions."
msgstr "在目前顯示預設上疊加 Carrot 風格的側向車道、盲區、變道、前車和雷達證據。此功能只影響顯示，不會改變變道或控制決策。"

msgid "Genius Visualization Preset"
msgstr "Genius 視覺化預設"

msgid "Choose one base display preset. Sunny is minimal, Carrot emphasizes lane, path, lead, and radar information, and Balanced keeps the Sunny HUD with Carrot-style lane and path cues. Fishop and Carrot World overlays are independent top layers."
msgstr "選擇一個基礎顯示預設。Sunny 最簡潔，Carrot 強化車道、路徑、前車和雷達資訊，平衡模式保留 Sunny HUD，並疊加 Carrot 風格車道和路徑提示。Fishop 和 Carrot World 是獨立的上層疊加顯示。"

msgid "Lane-Line Style"
msgstr "車道線樣式"

msgid "Simple uses white lanes and red road edges. Colored highlights active lane confidence. Carrot adds stronger adjacent-lane emphasis and torque color cues."
msgstr "Simple 使用白色車道線和紅色道路邊緣。Colored 突出顯示車道信心度。Carrot 會加強相鄰車道顯示，並加入轉向力矩顏色提示。"

msgid "Lead And Radar Display"
msgstr "前車和雷達顯示"

msgid "Chevron uses Sunny's lead marker. Box draws a Carrot-style lead-car frame. Radar also shows speed labels for tracked leads."
msgstr "Chevron 使用 Sunny 的前車標記。Box 繪製 Carrot 風格前車框。Radar 還會給追蹤到的前車顯示速度標籤。"

msgid "Base Display Layer"
msgstr "基礎顯示層"

msgid "Only one base road renderer is active at a time."
msgstr "同一時間只啟用一個基礎道路渲染器。"

msgid "Visual Detail Controls"
msgstr "顯示細節控制"

msgid "These refine the selected preset without changing planner or lane-change behavior."
msgstr "這些設定只細化目前預設，不改變規劃器或變道控制行為。"

msgid "Evidence Overlays"
msgstr "證據疊加層"

msgid "Carrot World and Fishop are independent display-only overlays. They may be enabled together on top of any base preset when you need lane-change or hardware evidence."
msgstr "Carrot World 和 Fishop 是獨立的顯示疊加層。需要查看變道或硬體證據時，它們可以同時疊加在任意基礎預設上。"

msgid "General HUD Widgets"
msgstr "一般 HUD 小組件"

msgid "These are normal Sunny/Genius HUD widgets and do not select the base road renderer."
msgstr "這些是一般 Sunny/Genius HUD 小組件，不負責選擇基礎道路渲染器。"

msgid "Phone Speed Limit Source"
msgstr "手機限速來源"

msgid "Use fresh APN/N, Navipilot, or Carrot phone speed-limit data before vehicle and map sources. Stale data times out automatically."
msgstr "優先使用新鮮的 APN/N、Navipilot 或 Carrot 手機限速資料，再回退到車機和地圖來源。過期資料會自動逾時。"

msgid "Carrot Active Speed Control"
msgstr "Carrot 主動速度控制"

msgid "Allow Carrot speed-limit, navigation, SDI, speed-bump, traffic-light, and model-speed evidence to adjust cruise targets when the related assist mode is enabled."
msgstr "在相關輔助模式啟用時，允許 Carrot 使用限速、導航、SDI、減速帶、紅綠燈和模型速度證據調整巡航目標。"

msgid "Carrot Auto Turn Slowdown"
msgstr "Carrot 自動轉彎減速"

msgid "Use Carrot navigation and curve information to slow for turns and junctions."
msgstr "使用 Carrot 導航和彎道資訊，在轉彎和路口前減速。"

msgid "Carrot Traffic Light Stop"
msgstr "Carrot 紅綠燈停車"

msgid "Use Carrot traffic-light input for red-light stop behavior."
msgstr "使用 Carrot 紅綠燈輸入執行紅燈停車行為。"

msgid "Deceleration strength for navigation speed events such as turns, speed cameras, speed bumps, and model-speed limits."
msgstr "導航速度事件的減速強度，例如轉彎、測速點、減速帶和模型速度限制。"

msgid "Speed Limit And Model-Speed"
msgstr "限速與模型速度"

msgid "Phone speed, vehicle speed, map speed, and model-speed evidence stay visible here; detailed source policy is inside Speed Limit."
msgstr "手機限速、車機限速、地圖限速和模型速度證據集中放在這裡；詳細來源策略在「限速」裡設定。"

msgid "Curve And Turn Slowdown"
msgstr "彎道與轉彎減速"

msgid "Sunny curve quality, Carrot navigation turns, lane-line curve input, and model-speed events are selected by explicit modes."
msgstr "Sunny 彎道品質、Carrot 導航轉彎、車道線曲率輸入和模型速度事件都透過明確模式選擇。"

msgid "Traffic Light Stop"
msgstr "紅綠燈停車"

msgid "Red-light behavior remains a separate Carrot gate and should be tested independently."
msgstr "紅燈停車仍然是獨立的 Carrot 開關，應單獨測試。"

msgid "Longitudinal Behavior"
msgstr "縱向控制行為"

msgid "DEC is separate from Carrot speed logic; the Carrot decel and following values remain user-tuneable while parked."
msgstr "DEC 與 Carrot 速度邏輯分開；Carrot 減速和跟車數值仍可在停車狀態下調整。"

msgid "Cruise Button Behavior"
msgstr "巡航按鍵行為"

msgid "Button behavior stays limited to local cruise-speed increment settings. ICBM/SCC-V/SCC-M remain hidden because they overlap Carrot cruise logic."
msgstr "按鍵行為僅限本地巡航速度步進設定。ICBM/SCC-V/SCC-M 與 Carrot 巡航邏輯重疊，因此繼續隱藏。"

msgid "Button behavior is limited to local cruise-speed increment settings. Curve, map, navigation, and traffic-light behavior are handled by the staged Carrot controls above."
msgstr "按鍵行為僅限本地巡航速度步進設定。彎道、地圖、導航和紅綠燈行為由上方分階段的 Carrot 控制項處理。"

msgid "Balanced"
msgstr "平衡"

msgid "Select the curve-speed strategy: Off, Sunny, Carrot, or Balanced. Balanced keeps Sunny curve quality and Carrot navigation/phone inputs together."
msgstr "選擇彎道控速策略：關閉、Sunny、Carrot 或平衡。平衡模式會同時使用 Sunny 的模型彎道能力和 Carrot 的導航/手機輸入。"

msgid "Select the curve-speed strategy: Off, Sunny, Carrot, or Balanced. Balanced keeps Sunny model-curvature quality and Carrot navigation/phone/lane inputs together."
msgstr "選擇彎道控速策略：關閉、Sunny、Carrot 或平衡。平衡模式會同時使用 Sunny 的模型曲率能力，以及 Carrot 的導航、手機和車道輸入。"

msgid "Select the turn-speed strategy: Off, Carrot, Sunny, or Balanced."
msgstr "選擇轉彎控速策略：關閉、Carrot、Sunny 或平衡。"

msgid "Curve Speed Factor"
msgstr "彎道速度因子"

msgid "Main Carrot curve-speed scaling value. Higher values make curve detection more sensitive, usually lowering the curve target speed and slowing earlier. If the lower-limit speed is already reached, raising this may have no further effect."
msgstr "Carrot 彎道速度主縮放值。數值越高，對彎道越敏感，通常會降低彎道目標速度並更早減速。如果已經降到最低彎道速度，繼續調高可能不會再產生效果。"

msgid "Curve Speed Aggressiveness"
msgstr "彎道速度激進度"

msgid "Secondary Carrot-compatible curve knob. Current active curve slowdown primarily uses Curve Speed Factor; keep this near 100 unless a later controller or Auto-Tuner recommendation explicitly uses it."
msgstr "相容 Carrot 的次級彎道旋鈕。目前主動彎道減速主要使用彎道速度因子；除非後續控制器或 Auto-Tuner 明確建議使用，否則建議保持在 100 附近。"

msgid "Navigation Decel Rate"
msgstr "導航減速比例"

msgid "Navigation-event deceleration scale. Lower values start slowing from farther away; higher values delay the slowdown and can feel later/stronger."
msgstr "導航事件減速比例。數值越低，會從更遠處開始減速；數值越高，會推遲減速，體感可能更晚也更強。"

msgid "Cruise Accel Limit 0 km/h"
msgstr "巡航加速度上限 0 km/h"

msgid "Cruise Accel Limit 10 km/h"
msgstr "巡航加速度上限 10 km/h"

msgid "Cruise Accel Limit 40 km/h"
msgstr "巡航加速度上限 40 km/h"

msgid "Cruise Accel Limit 60 km/h"
msgstr "巡航加速度上限 60 km/h"

msgid "Cruise Accel Limit 80 km/h"
msgstr "巡航加速度上限 80 km/h"

msgid "Cruise Accel Limit 110 km/h"
msgstr "巡航加速度上限 110 km/h"

msgid "Cruise Accel Limit 140 km/h"
msgstr "巡航加速度上限 140 km/h"

msgid "Maximum requested cruise acceleration near 80 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "80 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 0 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "0 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 10 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "10 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 40 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "40 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 60 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "60 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 110 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "110 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Maximum requested cruise acceleration near 140 km/h, in 0.01 m/s^2 units. Higher feels stronger; preserve known-good values unless Auto-Tuner recommends a change."
msgstr "140 km/h 附近的巡航請求加速度上限，單位為 0.01 m/s^2。數值越高加速越強；除非 Auto-Tuner 明確建議，否則建議保留已知可用值。"

msgid "Longitudinal Kp"
msgstr "縱向 Kp"

msgid "Carrot longitudinal proportional gain. Higher reacts harder to speed error; lower can reduce overshoot or oscillation."
msgstr "Carrot 縱向比例增益。數值越高，對速度誤差反應越強；數值降低可減少超調或震盪。"

msgid "Long Actuator Delay"
msgstr "縱向執行器延遲"

msgid "Longitudinal actuator delay in 0.01 s units. Higher anticipates slower actuator response; too high may feel early."
msgstr "縱向執行器延遲，單位為 0.01 秒。數值越高表示預判執行器反應更慢；過高可能會感覺動作過早。"

msgid "Stopping Speed Threshold"
msgstr "停車判定速度閾值"

msgid "Stopping detection threshold in 0.01 m/s units. Higher can smooth harsh stops; too high can enter stopping behavior early."
msgstr "停車判定速度閾值，單位為 0.01 m/s。數值調高可能緩和急停；過高可能過早進入停車邏輯。"

msgid "Lane/path lateral offset used by Carrot tuning. Zero is neutral; negative shifts left, positive shifts right."
msgstr "Carrot 調參使用的車道/路徑橫向偏移。0 為置中；負值向左偏，正值向右偏。"

msgid "Additional steering actuator delay target used by Auto-Tuner. Zero uses live/default delay; higher adds custom delay compensation."
msgstr "Auto-Tuner 使用的額外轉向執行器延遲目標。0 使用即時/預設延遲；數值越高，自訂延遲補償越多。"

msgid "Simple"
msgstr "簡潔"

msgid "Colored"
msgstr "彩色"

msgid "Chevron"
msgstr "箭頭"

msgid "Box"
msgstr "方框"

msgid "Radar"
msgstr "雷達"

msgid "Genius Pilot Local Mode"
msgstr "Genius Pilot 本地模式"

msgid "This personal build does not use Sunnylink or comma cloud pairing. Local Wi-Fi, SSH, Web, GitHub updates, and model downloads stay available."
msgstr "這個個人版不使用 Sunnylink 或 comma 雲端配對。本地 Wi-Fi、SSH、Web、GitHub 更新和模型下載仍然可用。"

msgid "Cloud upload, remote pairing, Sunnylink backup, and onroad uploads are disabled in Genius Pilot C3 alpha."
msgstr "Genius Pilot C3 alpha 已停用雲端上傳、遠端配對、Sunnylink 備份和行駛中上傳。"

msgid "Continue"
msgstr "繼續"

msgid "Data Uploads Disabled"
msgstr "資料上傳已關閉"

msgid ""
"Genius Pilot keeps cloud training uploads disabled in this personal C3 build.\n"
"\n"
"Local Wi-Fi, SSH, Web, GitHub updates, and model downloads remain available. Driving data is not uploaded from this page."
msgstr ""
"這個 Genius Pilot C3 個人版已關閉雲端訓練資料上傳。\n"
"\n"
"本地 Wi-Fi、SSH、Web、GitHub 更新和模型下載仍然可用。此頁面不會上傳駕駛資料。"

msgid ""
"For updates, bring your device inside and connect to a good USB-C adapter and Wi-Fi.\n"
"\n"
"Use the Software, Models, and Super Advanced pages for local maintenance. This page does not pair with comma, Sunnylink, or any cloud upload service."
msgstr ""
"需要更新時，把設備帶到室內並連接穩定的 USB-C 電源和 Wi-Fi。\n"
"\n"
"本地維護請使用 Software、Models 和 Super Advanced 頁面。此頁面不會與 comma、Sunnylink 或任何雲端上傳服務配對。"

msgid "Does this upload my drives?"
msgstr "這會上傳我的駕駛資料嗎？"

msgid "No. Cloud upload paths are disabled in Genius Pilot."
msgstr "不會。Genius Pilot 已停用雲端上傳路徑。"

msgid "Can I still update over Wi-Fi?"
msgstr "還能透過 Wi-Fi 更新嗎？"

msgid "Yes. GitHub updates and model downloads are local maintenance features."
msgstr "可以。GitHub 更新和模型下載屬於本地維護功能。"

msgid "What should I use this page for?"
msgstr "這個頁面用來做什麼？"

msgid "It is a reminder that cloud training upload mode is intentionally unavailable."
msgstr "它用於提示：雲端訓練上傳模式在本版本中被有意關閉。"

msgid "DISABLED: cloud uploads are off in this personal build"
msgstr "已停用：此個人版已關閉雲端上傳"

msgid "This personal build keeps cruise-speed behavior aligned with CarrotPilot. ICBM, SCC-V, and SCC-M stay hidden. Sunny DEC is available in Cruise and Super Advanced settings."
msgstr "這個個人版的巡航控速邏輯以 CarrotPilot 為準。ICBM、SCC-V 和 SCC-M 會隱藏。Sunny DEC 可在 Cruise 和 Super Advanced 設定中使用。"
